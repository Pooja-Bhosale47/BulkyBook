@model ProductVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white"> @(Model.Product.Id != 0 ? "Update" : "Create") Product</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-2">
        <form method="post" class="row" enctype="multipart/form-data">
            <input asp-for="Product.Id" hidden />
            <input asp-for="Product.ImageUrl" hidden />
            <div class="row">
                <div class="col-10">
                    <div class="border p-1 mt-1">
                        @* <div class="row pb-2">

                    <hr />
                </div> *@
                        <div asp-validation-summary="All"></div>
                        <div class="py-1 col-12">
                            <label asp-for="Product.Title" class="ms-2"></label>
                            <input asp-for="Product.Title" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.Title" class="text-danger"></span>
                        </div>
                        <div class="py-1 col-12">
                            <label asp-for="Product.Description" class="ms-2 text-muted"></label>
                            <textarea asp-for="Product.Description" class="form-control border-1 shadow"></textarea>

                            @*  <span asp-validation-for="Product.Description" class="text-danger"></span> *@
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.ISBN" class="ms-2"></label>
                            <input asp-for="Product.ISBN" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.ISBN" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.Author" class="ms-2"></label>
                            <input asp-for="Product.Author" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.Author" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.ListPrice" class="ms-2"></label>
                            <input asp-for="Product.ListPrice" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.Price" class="ms-2"></label>
                            <input asp-for="Product.Price" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.Price50" class="ms-2"></label>
                            <input asp-for="Product.Price50" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.Price50" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.Price100" class="ms-2"></label>
                            <input asp-for="Product.Price100" class="form-control border-1 shadow" />

                            <span asp-validation-for="Product.Price100" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            @*  <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select border-1 shadow">
                        <option disabled selected>--Select Category--</option>

                    </select> *@ @*ViewBag *@
                            @* <select asp-for="Product.CategoryId" asp-items="@(ViewData["CategoryList"] as IEnumerable<SelectListItem>)" class="form-select border-1 shadow">
                        <option disabled selected>--Select Category--</option>

                    </select> *@ @*ViewData *@

                            <label asp-for="Product.CategoryId" class="ms-2"></label>
                            <select asp-for="@Model.Product.CategoryId" asp-items="@Model.CategoryList" class="form-select border-1 shadow">
                                <option disabled selected>--Select Category--</option>

                            </select> @*using objects *@

                            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                        </div>

                        <div class="py-1 col-12">
                            <label asp-for="Product.ImageUrl" class="ms-1"></label>
                            <input type="file" name="file" class="form-control border-1 shadow mt-2" />


                        </div>

                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Product.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Update</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Create</button>
                                }
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary border form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>


                    </div>
                </div>
                <div class="col-2">
                    <img src="@Model.Product.ImageUrl" width="100%"
                    style="border-radius:5px; border:1px solid #bbb9b9" />
                </div>
            </div>
           

        </form>
    </div>
</div>



@section Scripts {
    <script>
            tinymce.init({
          selector: 'textarea',  // change this value according to the HTML
          plugins:'link lists charmap preview anchor pagebreak searchreplace wordcount visualblocks visualchars',
          toolbar: 'undo redo | styles | bold italic | alignleft aligncenter alignright alignjustify | outdent indent'
        });
    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}